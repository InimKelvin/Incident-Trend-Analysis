      <column caption='% Resolved' datatype='real' default-format='p0.00%' name='[% Closed (copy)_1248341527589302272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF [Status] = &quot;Resolved&quot; THEN 1 END)/COUNT([Incident ID])' />
